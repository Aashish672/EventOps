# ==============================================================================
# EventOps - Environment Variables Template
# Copy this file to .env and adjust values for your local development setup.
# DO NOT commit real secrets or production credentials to source control.
# ==============================================================================

# --- Backend / Django Settings ---
DEBUG=True
SECRET_KEY=django-insecure-local-dev-placeholder-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database (PostgreSQL) ---
# Default credentials align with docker-compose.yml
DATABASE_URL=postgres://eventops:eventops_password@localhost:5432/eventops_db
POSTGRES_DB=eventops_db
POSTGRES_USER=eventops
POSTGRES_PASSWORD=eventops_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Background Tasks & Caching (Redis / Celery) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Supabase (Auth, Postgres, Storage) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# --- AI Models / LangGraph ---
# Groq free tier for reasoning agents (Llama 3.3)
GROQ_API_KEY=your-groq-api-key-placeholder
# Gemini free tier for Document Intelligence (multimodal PDF reading)
GEMINI_API_KEY=your-gemini-api-key-placeholder

# --- Third-Party Integrations (Test Mode) ---
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
RESEND_API_KEY=re_placeholder
TWILIO_ACCOUNT_SID=AC_placeholder
TWILIO_AUTH_TOKEN=placeholder
TWILIO_PHONE_NUMBER=+15005550006

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000
